diff --git a/scripts/split-player-recent-matches.mjs b/scripts/split-player-recent-matches.mjs
new file mode 100644
index 0000000..e355aa9
--- /dev/null
+++ b/scripts/split-player-recent-matches.mjs
@@ -0,0 +1,41 @@
+// Splits player-recent-matches.json into one small file per player plus an index, so the player page
+// downloads a few kilobytes instead of the whole map.
+//
+//   node scripts/split-player-recent-matches.mjs [dataDir]
+//
+// dataDir defaults to artifacts/ipl-analytics/public/data. The full file is read, never changed. Output:
+//   <dataDir>/player-recent-matches/index.json   { source, generatedAt, keys: { [key]: [shard, matchCount] } }
+//   <dataDir>/player-recent-matches/<shard>.json  compact JSON array; keys that alias the same log share it
+// Keys keep the full file's order, so the page's key resolution behaves exactly as before.
+
+import fs from 'fs';
+import path from 'path';
+import crypto from 'crypto';
+import { pathToFileURL } from 'url';
+
+export function splitPlayerRecentMatches(dataDir = './artifacts/ipl-analytics/public/data') {
+  const map = JSON.parse(fs.readFileSync(path.join(dataDir, 'player-recent-matches.json'), 'utf8'));
+  const outDir = path.join(dataDir, 'player-recent-matches');
+  fs.mkdirSync(outDir, { recursive: true });
+
+  const keys = {};
+  const shards = new Map();
+  for (const [key, matches] of Object.entries(map)) {
+    const json = JSON.stringify(matches ?? []);
+    const id = crypto.createHash('sha1').update(json).digest('hex').slice(0, 12);
+    shards.set(id, json);
+    keys[key] = [id, Array.isArray(matches) ? matches.length : 0];
+  }
+  for (const [id, json] of shards) fs.writeFileSync(path.join(outDir, `${id}.json`), json);
+  // Shards from an earlier run that no key points to any more (this directory holds generated files only).
+  for (const f of fs.readdirSync(outDir)) {
+    if (f.endsWith('.json') && f !== 'index.json' && !shards.has(f.slice(0, -5))) fs.rmSync(path.join(outDir, f));
+  }
+  fs.writeFileSync(path.join(outDir, 'index.json'), JSON.stringify({ source: 'player-recent-matches.json', generatedAt: new Date().toISOString(), keys }));
+  return { keys: Object.keys(keys).length, shards: shards.size, outDir };
+}
+
+if (process.argv[1] && import.meta.url === pathToFileURL(path.resolve(process.argv[1])).href) {
+  const r = splitPlayerRecentMatches(process.argv[2]);
+  console.log(`Split ${r.keys} keys into ${r.shards} shards in ${r.outDir}`);
+}
