diff --git a/artifacts/ipl-analytics/src/lib/player-recent-matches.ts b/artifacts/ipl-analytics/src/lib/player-recent-matches.ts
new file mode 100644
index 0000000..0c3f18a
--- /dev/null
+++ b/artifacts/ipl-analytics/src/lib/player-recent-matches.ts
@@ -0,0 +1,111 @@
+// Recent matches for the player page, loaded per player instead of as one 34 MB file.
+//
+// scripts/split-player-recent-matches.mjs writes, next to the full file:
+//   data/player-recent-matches/index.json     { keys: { [key]: [shard, matchCount] } }
+//   data/player-recent-matches/<shard>.json   one player's match log (alias keys share a shard)
+// The page downloads the index and one shard. If the index is missing (split not generated or not
+// deployed) it falls back to the full file, so the page never depends on the split existing.
+
+import { useMemo } from "react";
+import { useQuery } from "@tanstack/react-query";
+
+// eslint-disable-next-line @typescript-eslint/no-explicit-any
+export type RecentMatch = any;
+type BioNames = { playerName?: string; fullName?: string } | null | undefined;
+interface RecentMatchesIndex { keys: Record<string, [string, number]> }
+
+const EMPTY: RecentMatch[] = [];
+const HOUR = 1000 * 60 * 60;
+
+/**
+ * Finds the key for a player. The steps and their order are exactly those the player page used when it
+ * held the whole map (exact slug/name keys, then initial + surname, then surname, then a loose match);
+ * `lengths` maps every key to its match count, in the file's key order.
+ */
+export function resolveRecentMatchesKey(lengths: Record<string, number>, slug: string | undefined, bio: BioNames): string | null {
+  const has = (k: string | undefined): boolean => !!k && (lengths[k] ?? 0) > 0;
+  const mapKeys = Object.keys(lengths);
+  const s = slug?.toLowerCase()?.trim() || "";
+  const nameSlug = bio?.playerName?.toLowerCase()?.replace(/[^a-z0-9]+/g, "-") || "";
+  const fullSlug = bio?.fullName?.toLowerCase()?.replace(/[^a-z0-9]+/g, "-") || "";
+
+  // 1. Direct match by slug or names
+  if (has(s)) return s;
+  if (has(nameSlug)) return nameSlug;
+  if (has(fullSlug)) return fullSlug;
+
+  // 2. Initial + surname matching (e.g. "virat-kohli" -> "v-kohli", "tm-head", "jj-bumrah")
+  const parts = s.split("-").filter(Boolean);
+  if (parts.length >= 2) {
+    const initial = parts[0][0];
+    const surname = parts[parts.length - 1];
+    const candidate1 = `${initial}-${surname}`;
+    if (has(candidate1)) return candidate1;
+
+    const candidate2 = mapKeys.find((k) => {
+      const kp = k.split("-");
+      return kp.length >= 2 && kp[kp.length - 1] === surname && kp[0].startsWith(initial);
+    });
+    if (candidate2 && has(candidate2)) return candidate2;
+  }
+
+  // 3. Surname match if distinct
+  if (parts.length > 0) {
+    const surname = parts[parts.length - 1];
+    if (surname.length >= 4) {
+      const candidate3 = mapKeys.find((k) => k.endsWith(`-${surname}`) || k === surname);
+      if (candidate3 && has(candidate3)) return candidate3;
+    }
+  }
+
+  // 4. Clean fuzzy search (returned even when that key's log is empty, as before)
+  const cleanS = s.replace(/[^a-z0-9]/g, "");
+  const cleanN = nameSlug.replace(/[^a-z0-9]/g, "");
+  const matchedKey = mapKeys.find((k) => {
+    const cleanK = k.replace(/[^a-z0-9]/g, "");
+    return cleanK === cleanS || cleanK === cleanN || (cleanS.length > 4 && cleanK.includes(cleanS)) || (cleanK.length > 4 && cleanS.includes(cleanK));
+  });
+  return matchedKey ?? null;
+}
+
+/** The player's recent matches, newest first (same array the page previously took from the full map). */
+export function usePlayerRecentMatches(slug: string | undefined, bio: BioNames): RecentMatch[] {
+  const base = import.meta.env.BASE_URL;
+  const index = useQuery<RecentMatchesIndex | null>({
+    queryKey: ["player-recent-matches-index"],
+    queryFn: async () => {
+      const res = await fetch(`${base}data/player-recent-matches/index.json`);
+      return res.ok ? res.json() : null;
+    },
+    staleTime: HOUR,
+  });
+  // Fallback: the full file, only when the index is unavailable.
+  const full = useQuery<Record<string, RecentMatch[]>>({
+    queryKey: ["player-recent-matches"],
+    queryFn: async () => {
+      const res = await fetch(`${base}data/player-recent-matches.json`);
+      return res.ok ? res.json() : {};
+    },
+    enabled: index.isFetched && !index.data,
+    staleTime: HOUR,
+  });
+  const lengths = useMemo(() => {
+    if (index.data) return Object.fromEntries(Object.entries(index.data.keys).map(([k, v]) => [k, v[1]]));
+    if (full.data) return Object.fromEntries(Object.entries(full.data).map(([k, v]) => [k, v?.length ?? 0]));
+    return null;
+  }, [index.data, full.data]);
+  const key = useMemo(() => (lengths ? resolveRecentMatchesKey(lengths, slug, bio) : null), [lengths, slug, bio]);
+  const shardId = key && index.data ? index.data.keys[key]?.[0] ?? null : null;
+  const shard = useQuery<RecentMatch[]>({
+    queryKey: ["player-recent-matches-shard", shardId],
+    queryFn: async () => {
+      const res = await fetch(`${base}data/player-recent-matches/${shardId}.json`);
+      return res.ok ? res.json() : [];
+    },
+    enabled: !!shardId,
+    staleTime: HOUR,
+  });
+  if (!key) return EMPTY;
+  if (index.data) return shard.data ?? EMPTY;
+  return full.data?.[key] ?? EMPTY;
+}
