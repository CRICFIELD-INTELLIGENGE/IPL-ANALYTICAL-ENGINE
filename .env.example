# CricField environment variables: NAMES ONLY. Never commit real values.
# API values: env/api.env at the repo root (git-ignored) or the host environment.
# Frontend values: artifacts/ipl-analytics/.env.local (git-ignored). VITE_* values are PUBLIC; never put secrets there.
# Defaults in comments are the ones the code uses when a variable is unset.

# --- API server -------------------------------------------------------------
NODE_ENV=
# default 5000
PORT=
LOG_LEVEL=
# number of trusted proxy hops; default 1 in production
TRUST_PROXY=
# comma-separated allowed cross-origin hosts
CORS_ORIGINS=
# default 600
RATE_LIMIT_API_PER_MIN=
# default 60
RATE_LIMIT_HEAVY_PER_MIN=
# >= 24 chars; admin routes answer 404 when unset
ADMIN_API_TOKEN=

# --- Databases and data files ----------------------------------------------
# 1 = open sqlite.db read-only (deployed API, all tests)
CRICFIELD_DB_READONLY=
# path to a sqlite.db COPY; default <repo>/sqlite.db
CRICFIELD_DB_PATH=
# default lib/cricket-data/global/warehouse/global.db
CRICFIELD_SCOUT_DB_PATH=
# default <cwd>/data/platform.sqlite
PLATFORM_DB_PATH=
AUCTION_LOG_PATH=
TRANSACTIONS_FILE=
INTELLIGENCE_DIR=

# --- AI (server only) --------------------------------------------------------
# ollama | openrouter | groq | cloudflare; default openrouter in production, else ollama
AI_PROVIDER=
AI_ANALYST_ENABLED=
AI_ANALYST_DAILY_LIMIT=
AI_COMMENTARY_ENABLED=
AI_DAILY_REQUEST_LIMIT=
OLLAMA_BASE_URL=
OLLAMA_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_MODEL=
SCOUT_WEB_SEARCH_ENABLED=
SERPAPI_API_KEY=
# video / clip services
ANAKIN_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=

# --- Platform: auth, notifications (server only) -----------------------------
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
PLATFORM_WORKER_ENABLED=
NOTIFICATION_SIGNING_SECRET=
RESEND_API_KEY=
NOTIFICATION_EMAIL_FROM=
PUBLIC_SITE_URL=
DIGEST_HOUR_UTC=
CRICKET_EVENT_FEED_URL=
WHATSAPP_ALERTS_ENABLED=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_NOTIFICATION_TEMPLATE=
META_GRAPH_VERSION=
META_TEMPLATE_LANGUAGE=

# --- Frontend (public, build-time) ------------------------------------------
VITE_BACKEND_PORT=
VITE_SITE_ORIGIN=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_GA_MEASUREMENT_ID=
VITE_ADSENSE_ENABLED=
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOTS=
VITE_ENABLE_ADMIN_PAGES=
VITE_WHATSAPP_NUMBER=
# dev server (vite.config.ts)
BASE_PATH=
CRICFIELD_API_AUTOSTART=
CRICFIELD_ARCADE_AUTOSTART=

# --- Scripts and tests only ------------------------------------------------------
GLOBAL_DB=
CORRECTED_DB=
DRIZZLE_ALLOW_PRODUCTION=
PRESSURE_SOURCE=
PRESSURE_SNAPSHOT=
PRESSURE_OUT=
PRESSURE_CLIENT_OUT=
PRESSURE_REPORT_DIR=
E2E_BASE_URL=
E2E_MODE=
E2E_API_PORT=
E2E_WEB_PORT=
E2E_WORKERS=
E2E_CHANNEL=
E2E_STRICT_LAYOUT=

# --- integrations/whatsapp-prototype --------------------------------------------
WHATSAPP_PORT=
WHATSAPP_SEND_ENABLED=
