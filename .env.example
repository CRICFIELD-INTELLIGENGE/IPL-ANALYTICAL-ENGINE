# Server configuration. Never prefix credentials with VITE_.
NODE_ENV=development
PORT=5000
CRICFIELD_DB_READONLY=1
# Absolute path to the existing warehouse if running outside the repository.
CRICFIELD_DB_PATH=
# Set to the exact trusted reverse-proxy hop count for your deployment.
TRUST_PROXY=0
CORS_ORIGINS=
ADMIN_API_TOKEN=
AUCTION_LOG_PATH=
RATE_LIMIT_API_PER_MIN=600
RATE_LIMIT_HEAVY_PER_MIN=60
# AI provider: Cloudflare Workers AI (OpenRouter remains optional).
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3:latest
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
AI_COMMENTARY_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
AI_ANALYST_ENABLED=false
AI_ANALYST_DAILY_LIMIT=100
AI_DAILY_REQUEST_LIMIT=100
ANAKIN_API_KEY=

# Platform notifications and analytics (server only)
SUPABASE_URL=https://jilxgxuamfloacsfadso.supabase.co
SUPABASE_PUBLISHABLE_KEY=
PLATFORM_WORKER_ENABLED=false
PLATFORM_DB_PATH=
NOTIFICATION_SIGNING_SECRET=
RESEND_API_KEY=
NOTIFICATION_EMAIL_FROM=
PUBLIC_SITE_URL=
WHATSAPP_ALERTS_ENABLED=false
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_NOTIFICATION_TEMPLATE=
META_GRAPH_VERSION=
META_TEMPLATE_LANGUAGE=en
DIGEST_HOUR_UTC=18
CRICKET_EVENT_FEED_URL=
# Optional web evidence, server-only
SCOUT_WEB_SEARCH_ENABLED=false
SERPAPI_API_KEY=

# Shared provider for Scout, analyst and AI commentary
# Set AI_PROVIDER=groq to use these server-only fields
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
