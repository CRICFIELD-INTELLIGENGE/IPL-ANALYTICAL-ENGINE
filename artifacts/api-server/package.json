{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --import tsx src/index.ts",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "intelligence:features": "tsx scripts/intelligence/01-build-features.ts",
    "intelligence:fit": "python scripts/intelligence/train.py",
    "intelligence:publish": "tsx scripts/intelligence/02-publish.ts",
    "intelligence:train": "pnpm run intelligence:features && pnpm run intelligence:fit && pnpm run intelligence:publish",
    "test": "tsx --import ./test/test-readonly-env.mjs --test test/*.test.ts"
  },
  "dependencies": {
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "drizzle-orm": "catalog:",
    "express": "^5",
    "fast-xml-parser": "^5.11.0",
    "javascript-lp-solver": "0.4.24",
    "pino": "^9",
    "pino-http": "^10",
    "zod": "^3.23.8",
    "@workspace/arcade-rules": "workspace:*"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "cheerio": "^1.2.0",
    "esbuild": "^0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13",
    "puppeteer": "^25.0.2",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  }
}
