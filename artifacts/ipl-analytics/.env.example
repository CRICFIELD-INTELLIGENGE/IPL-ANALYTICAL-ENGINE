# Copy to .env.local and fill in. Vite only exposes variables prefixed VITE_,
# and they are baked into the client bundle at build time — so these are public
# identifiers, never secrets. Do not put an API key or an Ads developer token
# here; anything in this file ships to every visitor's browser.

# ── Google Analytics 4 ───────────────────────────────────────────────────────
# Create a GA4 property at analytics.google.com → Admin → Data streams → Web.
# The measurement ID looks like G-XXXXXXXXXX (a "UA-" id is the retired
# Universal Analytics and will not work).
# Leave blank and no analytics script is loaded at all.
VITE_GA_MEASUREMENT_ID=

# ── Google AdSense ───────────────────────────────────────────────────────────
# This is what pays out on a content site. "Google Ads" (ads.google.com) is the
# other side of the market — that is for buying traffic, not earning from it.
#
# The publisher id looks like ca-pub-0000000000000000, from adsense.google.com
# → Account → Settings. Individual placements also need an ad unit id, passed to
# <AdSlot slot="1234567890" />.
#
# AdSense will not approve a site that is not live on its own domain with real
# content, and it requires an ads.txt at the domain root containing:
#   google.com, pub-0000000000000000, DIRECT, f08c47fec0942fa0
# Leave blank and no ad script is loaded and no ad slots render.
VITE_ADSENSE_CLIENT=

# ── Backend ──────────────────────────────────────────────────────────────────
# Port the API server listens on; the Vite dev proxy forwards /api here.
VITE_BACKEND_PORT=5000
