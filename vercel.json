{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "pnpm --filter @workspace/ipl-analytics run build",
  "outputDirectory": "artifacts/ipl-analytics/dist/public",
  "installCommand": "pnpm install",
  "framework": null,
  "functions": {
    "api/warehouse-preview.mjs": {
      "maxDuration": 300,
      "memory": 1024,
      "includeFiles": "{artifacts/api-server/data/**,artifacts/ipl-analytics/public/data/matches.json,artifacts/ipl-analytics/public/data/players.json,artifacts/ipl-analytics/public/data/player-bio.json,artifacts/ipl-analytics/public/data/current-squads.json}"
    }
  },
  "rewrites": [
    {
      "source": "/home/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/home/sitemap-dugout.xml",
      "destination": "/sitemap-dugout.xml"
    },
    {
      "source": "/api/auction-2027",
      "destination": "/api/warehouse-preview?__warehouseRoute=/api/auction-2027"
    },
    {
      "source": "/api/retention/2027/official",
      "destination": "/api/warehouse-preview?__warehouseRoute=/api/retention/2027/official"
    },
    {
      "source": "/api/retention/2027/franchises/:team/official",
      "destination": "/api/warehouse-preview?__warehouseRoute=/api/retention/2027/franchises/:team/official"
    },
    {
      "source": "/api/stats/:path*",
      "destination": "/api/warehouse-preview?__warehouseRoute=/api/stats/:path*"
    },
    {
      "source": "/api/ipl/:path*",
      "destination": "/api/warehouse-preview?__warehouseRoute=/api/ipl/:path*"
    },
    {
      "source": "/api/scout/:path*",
      "destination": "/api/warehouse-preview?__warehouseRoute=/api/scout/:path*"
    },
    {
      "source": "/api/:section(ask|decision|strategy|alt-universe|replay|opposition|pool|squad-dna|war-room|intel|optimizer|history|players|weakness|pressure|insights|intelligence)/:path*",
      "destination": "/api/warehouse-preview?__warehouseRoute=/api/:section/:path*"
    },
    {
      "source": "/api/retention/2027/franchises/:team/picks",
      "destination": "/api/warehouse-preview?__warehouseRoute=/api/retention/2027/franchises/:team/picks"
    },
    {
      "source": "/editorials",
      "destination": "/seo/editorials.html"
    },
    {
      "source": "/auction",
      "destination": "/seo/auction.html"
    },
    {
      "source": "/tactics",
      "destination": "/seo/tactics.html"
    },
    {
      "source": "/venues",
      "destination": "/seo/venues.html"
    },
    {
      "source": "/storylines",
      "destination": "/seo/storylines.html"
    },
    {
      "source": "/retention-room",
      "destination": "/seo/retention-room.html"
    },
    {
      "source": "/squad-hq",
      "destination": "/seo/squad-hq.html"
    },
    {
      "source": "/reports",
      "destination": "/seo/reports.html"
    },
    {
      "source": "/blogs",
      "destination": "/seo/blogs.html"
    },
    {
      "source": "/home",
      "destination": "/seo/home.html"
    },
    {
      "source": "/feed",
      "destination": "/seo/feed.html"
    },
    {
      "source": "/feed/ipl-2027",
      "destination": "/seo/feed-ipl-2027.html"
    },
    {
      "source": "/feed/ipl-2027/retentions",
      "destination": "/seo/feed-ipl-2027-retentions.html"
    },
    {
      "source": "/stats",
      "destination": "/seo/stats.html"
    },
    {
      "source": "/pulse",
      "destination": "/seo/pulse.html"
    },
    {
      "source": "/scores",
      "destination": "/seo/scores.html"
    },
    {
      "source": "/dugout",
      "destination": "/seo/dugout.html"
    },
    {
      "source": "/pressurelab",
      "destination": "/seo/pressurelab.html"
    },
    {
      "source": "/pressurelab/compare",
      "destination": "/seo/pressurelab-compare.html"
    },
    {
      "source": "/pressurelab/roles",
      "destination": "/seo/pressurelab-roles.html"
    },
    {
      "source": "/ai-analyst",
      "destination": "/seo/ai-analyst.html"
    },
    {
      "source": "/about",
      "destination": "/seo/about.html"
    },
    {
      "source": "/methodology",
      "destination": "/seo/methodology.html"
    },
    {
      "source": "/data-sources",
      "destination": "/seo/data-sources.html"
    },
    {
      "source": "/contact",
      "destination": "/seo/contact.html"
    },
    {
      "source": "/disclaimer",
      "destination": "/seo/disclaimer.html"
    },
    {
      "source": "/privacy",
      "destination": "/seo/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/seo/terms.html"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/sitemap-dugout.xml",
      "destination": "/sitemap-dugout.xml"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "codex/unified-desktop-stats-slicing": false
    }
  }
}
