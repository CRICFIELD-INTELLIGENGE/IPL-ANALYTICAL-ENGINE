{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "pnpm --filter @workspace/api-server exec node build.mjs --warehouse-preview && pnpm --filter @workspace/ipl-analytics run build",
  "outputDirectory": "artifacts/ipl-analytics/dist/public",
  "installCommand": "pnpm install",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/scout/rankings",
      "destination": "/api/warehouse-preview?__warehouseRoute=/api/scout/rankings"
    },
    {
      "source": "/api/scout/t20/suggestions",
      "destination": "/api/warehouse-preview?__warehouseRoute=/api/scout/t20/suggestions"
    },
    {
      "source": "/api/ipl/overview",
      "destination": "/api/warehouse-preview?__warehouseRoute=/api/ipl/overview"
    },
    {
      "source": "/api/ipl/seasons",
      "destination": "/api/warehouse-preview?__warehouseRoute=/api/ipl/seasons"
    },
    {
      "source": "/api/ipl/player-career-stats",
      "destination": "/api/warehouse-preview?__warehouseRoute=/api/ipl/player-career-stats"
    },
    {
      "source": "/api/ipl/player-season-stats",
      "destination": "/api/warehouse-preview?__warehouseRoute=/api/ipl/player-season-stats"
    },
    {
      "source": "/api/ipl/stats/query",
      "destination": "/api/warehouse-preview?__warehouseRoute=/api/ipl/stats/query"
    },
    {
      "source": "/api/ipl/stats/matchup",
      "destination": "/api/warehouse-preview?__warehouseRoute=/api/ipl/stats/matchup"
    },
    {
      "source": "/api/ipl/stats/scenario",
      "destination": "/api/warehouse-preview?__warehouseRoute=/api/ipl/stats/scenario"
    },
    {
      "source": "/api/ipl/stats/drilldown",
      "destination": "/api/warehouse-preview?__warehouseRoute=/api/ipl/stats/drilldown"
    },
    {
      "source": "/api/stats/query",
      "destination": "/api/warehouse-preview?__warehouseRoute=/api/stats/query"
    },
    {
      "source": "/api/stats/scenario",
      "destination": "/api/warehouse-preview?__warehouseRoute=/api/stats/scenario"
    },
    {
      "source": "/api/stats/matchup",
      "destination": "/api/warehouse-preview?__warehouseRoute=/api/stats/matchup"
    },
    {
      "source": "/api/stats/drilldown",
      "destination": "/api/warehouse-preview?__warehouseRoute=/api/stats/drilldown"
    },
    {
      "source": "/((?!api/(?:turso-preview|warehouse-preview|scout/t20/coverage)/?$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "functions": {
    "api/warehouse-preview.mjs": {
      "maxDuration": 60,
      "includeFiles": "{artifacts/ipl-analytics/public/data/{overview,seasons,matches,player-bio,players,current-squads,player-latest-teams,player-career-stats,player-season-stats}.json,artifacts/api-server/data/players.json,data/auction-2027-updates.json}"
    }
  }
}
