    "global:onboard": "tsx ./src/global/onboard.ts",
    "global:bench": "tsx ./src/global/bench.ts",
    "test:global": "tsx --import ./src/test-readonly-env.mjs --test src/global/tests/*.test.ts src/scout/tests/*.test.ts",
