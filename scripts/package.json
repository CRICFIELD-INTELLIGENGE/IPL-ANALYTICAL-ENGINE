    "aggregate-kaggle-bowlers": "tsx ./src/aggregate-kaggle-bowlers.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate-players": "tsx ./src/migrate_players.ts",
    "migrate-matches": "tsx ./src/migrate_matches.ts",
    "migrate-deliveries": "tsx ./src/migrate_deliveries.ts",
    "compute-analytics": "tsx ./src/compute_analytics.ts",
    "update-ipl-data": "tsx ./src/update-ipl-data.ts",
