    "global:normalize": "tsx ./src/global/normalize.ts",
    "global:identity": "tsx ./src/global/identity.ts",
    "global:aggregate": "tsx ./src/global/aggregate.ts",
    "global:validate": "tsx ./src/global/validate.ts",
    "global:build": "tsx ./src/global/sync.ts --skip-download",
